<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (PipWidget): Catch, Hey Pip on/off, Open. Colors and sizes from colors.xml / dimens.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:id="@+id/widget_catch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/widget_seed"
            android:layout_height="@dimen/widget_seed"
            android:layout_marginEnd="@dimen/widget_padding"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_seed"
            android:tint="@color/on_sprout" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans"
            android:text="@string/widget_catch"
            android:textColor="@color/on_sprout"
            android:textSize="@dimen/widget_catch_text"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_toggle"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/widget_padding"
        android:fontFamily="@font/instrument_sans"
        android:gravity="center"
        android:paddingHorizontal="@dimen/widget_padding"
        android:text="@string/widget_hey_pip_off"
        android:textColor="@color/ink"
        android:textSize="@dimen/widget_option_text" />

    <TextView
        android:id="@+id/widget_open"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:fontFamily="@font/instrument_sans"
        android:gravity="center"
        android:paddingHorizontal="@dimen/widget_padding"
        android:text="@string/widget_open"
        android:textColor="@color/ink"
        android:textSize="@dimen/widget_option_text" />
</LinearLayout>
