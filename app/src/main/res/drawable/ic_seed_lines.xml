<?xml version="1.0" encoding="utf-8"?>
<!-- The seed's line art (values/logo.xml), thickened. White; Compose draws it in the seed's line colour over ic_seed_solid. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="528"
    android:viewportHeight="528">
    <group
        android:translateX="12"
        android:translateY="12">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="@string/seed_lines_path"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineJoin="round"
            android:strokeWidth="10" />
    </group>
</vector>
