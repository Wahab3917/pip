<?xml version="1.0" encoding="utf-8"?>
<!-- App icon foreground: the paper seed with deep-green lines (values/logo.xml), optically centred in the 108dp adaptive canvas inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.0985"
        android:scaleY="0.0985"
        android:translateX="26.42"
        android:translateY="26.42">
    <group
            android:translateX="12"
            android:translateY="44">
            <path
                android:fillColor="@color/logo_seed"
                android:pathData="@string/seed_solid_path" />
            <path
                android:fillColor="@color/logo_seed_line"
                android:pathData="@string/seed_lines_path"
                android:strokeColor="@color/logo_seed_line"
                android:strokeLineJoin="round"
                android:strokeWidth="10" />
        </group>
    </group>
</vector>
