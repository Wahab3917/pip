<?xml version="1.0" encoding="utf-8"?>
<!--
    App icon foreground: the Paper-coloured seed (values/logo.xml) centred in the 108dp adaptive-icon
    canvas, kept inside the 66dp safe zone. Also used as the monochrome (themed) icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2"
        android:scaleY="2"
        android:translateX="30"
        android:translateY="30">
        <path
            android:fillColor="@color/logo_seed"
            android:pathData="@string/seed_path" />
    </group>
</vector>
