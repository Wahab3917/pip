<?xml version="1.0" encoding="utf-8"?>
<!-- Pip backs nothing up (local-first); see also data_extraction_rules.xml for Android 12+. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
</full-backup-content>
