<?xml version="1.0" encoding="utf-8"?>
<!--
    Pip is local-first: thoughts never leave the phone, so nothing is backed up or copied
    to a new device. (android:allowBackup="false" covers Android 11 and older; these rules
    cover Android 12+.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
