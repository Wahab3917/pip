<?xml version="1.0" encoding="utf-8"?>
<!--
    2 x 2 cells, fixed size; never updated on a timer (PipWidget.updateAll() runs when something it
    shows changes). previewLayout (Android 12+) makes the widget picker show the real widget instead
    of a blank card with the app icon.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_pip"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_pip"
    android:resizeMode="none"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
